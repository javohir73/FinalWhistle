# Copy to .env (backend) and frontend/.env.local as noted. Never commit real secrets.

# ---- Backend (FastAPI) ----
# Local docker-compose Postgres. Override with your hosted DB URL in production.
DATABASE_URL=postgresql+psycopg2://wc26:wc26@localhost:5432/wc26
# Shared secret guarding POST /api/internal/recompute (the cron job sends this).
RECOMPUTE_TOKEN=dev-recompute-token
# Comma-separated allowed frontend origins for CORS. The www/apex sibling of each
# entry is auto-allowed, and the same list also powers the Origin (CSRF) guard.
CORS_ORIGINS=http://localhost:3000
# Optional anchored regex admitting extra origins (e.g. this project's Vercel
# previews). Leave BLANK in production — a loose *.vercel.app pattern is a CSRF
# hole. Example (set only on a preview/staging service):
# CORS_PREVIEW_REGEX=^https://fifa-wc26-prediction-[a-z0-9-]+\.vercel\.app$
# REQUIRED for local dev (both default to production-safe values otherwise):
# - COOKIE_SECURE=false: localhost is plain http; with the Secure flag set the
#   session cookie is dropped (Safari always; sign-in appears to work but never
#   sticks). Keep "true" in production.
# - ENVIRONMENT=development: relaxes the production-only Origin requirement so
#   curl/tests work without an Origin header.
ENVIRONMENT=development
COOKIE_SECURE=false
# Optional overrides:
# APP_NAME=FinalWhistle
# MODEL_VERSION=poisson-elo-v0.1
# Keep fixture-specific NRL scorelines hidden until the backtest clears its
# promotion gate. Set true only after a qualifying model has been reviewed.
NRL_SCORE_MODEL_PROMOTED=false

# ---- Prediction-market capture worker (DEFAULT OFF) ----
# Public read-only venue APIs; no trading credentials, no account access.
# The worker REFUSES TO START unless both MARKET_CAPTURE_ENABLED is true and
# MARKET_CAPTURE_MARKET_KEYS is non-empty. An empty key list captures nothing
# and is never read as "capture every market on the venue".
MARKET_CAPTURE_ENABLED=false
MARKET_CAPTURE_MARKET_KEYS=
MARKET_CAPTURE_VENUES=kalshi,polymarket
MARKET_CAPTURE_WORKER_ID=market-capture-local
MARKET_CAPTURE_DISCOVERY_SECONDS=21600
MARKET_CAPTURE_PREMATCH_SECONDS=300
MARKET_CAPTURE_INPLAY_SECONDS=30
MARKET_CAPTURE_MAX_MARKETS_PER_VENUE=5
# "eligible" persists only the exact bounded capture set. Use "all" only for
# an explicitly approved full-catalogue registry acceptance run.
MARKET_CAPTURE_REGISTRY_SCOPE=eligible
MARKET_CAPTURE_TIMEOUT_SECONDS=15
MARKET_CAPTURE_RETRY_LIMIT=3
MARKET_CAPTURE_BACKOFF_INITIAL_SECONDS=0.5
MARKET_CAPTURE_BACKOFF_MAX_SECONDS=8
MARKET_CAPTURE_BOOK_TOP_N=10
MARKET_CAPTURE_STALE_SECONDS=300
MARKET_CAPTURE_UNSETTLED_WARNING_SECONDS=86400
MARKET_CAPTURE_RAW_STORE_PATH=var/market-intel-raw
# Bounded raw retention: a payload over the byte cap is refused, not stored,
# and rejected payloads are kept per cycle only up to this count.
MARKET_CAPTURE_MAX_RAW_PAYLOAD_BYTES=2000000
MARKET_CAPTURE_MAX_REJECTED_PER_CYCLE=5
# Retention horizon for stored raw objects. The byte ceiling bounds each
# object; only this bounds the total. Locally the worker deletes past it; for
# object storage the bucket lifecycle rule is READ AND VERIFIED at startup and
# a missing or longer rule is a refusal, not a warning. 0 = keep forever and
# is rejected outright for the s3 backend.
MARKET_CAPTURE_RAW_RETENTION_DAYS=90
# Production object storage (do not provision until the stop gate is approved):
# MARKET_CAPTURE_RAW_STORE_BACKEND=s3
# MARKET_CAPTURE_RAW_STORE_BUCKET=
# MARKET_CAPTURE_RAW_STORE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# MARKET_CAPTURE_RAW_STORE_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Transactional email (password reset, email verification) ----
# EMAIL_PROVIDER=console (default) logs links and makes no network call — fine for
# local dev. Set to "resend" + EMAIL_API_KEY in production to actually send. An
# empty key falls back to console (never crashes the auth flow).
# EMAIL_PROVIDER=console
# EMAIL_API_KEY=
# EMAIL_FROM=FinalWhistle <noreply@finalwhistle.app>
# Base URL used to build links in emails — must be an allowed origin.
# PUBLIC_BASE_URL=https://fifa-wc26-prediction.vercel.app

# ---- Live in-game scores ----
# Live updates are active only when LIVE_MODE_ENABLED=true AND the selected
# provider's key is set (otherwise a safe no-op). The board's 30s poll drives
# refreshes — no cron required.
LIVE_MODE_ENABLED=false
# Provider: "football_data" or "api_football" (both have ingestion wired).
#   football_data : free tier; scores delayed, live minute ESTIMATED from kickoff
#   api_football  : real OFFICIAL live minute (status.elapsed) — best for real-time
LIVE_PROVIDER=football_data
# football-data.org — FREE key at https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
# API-Football (api-sports.io) — real-time. Key at https://dashboard.api-sports.io
# (free tier includes the live minute, 100 req/day). To use it, also set
# LIVE_PROVIDER=api_football above.
# API_FOOTBALL_API_KEY=

# ---- Frontend (Next.js) — put this in frontend/.env.local ----
# Base URL of the backend API the browser calls.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Independent validation data sources (docs/VALIDATION-DATA-SOURCES.md) ---
# All DEFAULT OFF. Absent = that source is skipped with a recorded reason; it
# never affects production or shadow writes. Betfair needs no key at all: it is
# an offline importer for archives you downloaded yourself.
ODDS_API_KEY=
# FOOTBALL_DATA_API_KEY is already declared above and is reused here.
